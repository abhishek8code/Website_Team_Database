@model GECPATAN_FACULTY_PORTAL.Models.CommitteeVision

<h4>Committee Vision</h4>
<hr />

<p class="mt-3">
    @Model.VisionText
</p>

<div class="mt-4">
    <a asp-action="ManageVision"
       asp-route-committeeId="@Model.CommitteeId"
       class="btn btn-warning btn-sm">
        Manage Vision
    </a>

    <a asp-action="Index"
       class="btn btn-secondary btn-sm ms-2">
        Back to Committees
    </a>
</div>
