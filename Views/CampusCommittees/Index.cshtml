@model IEnumerable<GECPATAN_FACULTY_PORTAL.Models.CampusCommittee>

<h2>Campus Committees</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    + Add Campus Committee
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Tagline</th>
            <th style="width:220px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Tagline</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                        Details
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                        Edit
                    </a>
                    <a asp-action="Vision"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Vision
                    </a>
                    <a asp-action="ManageMission"
                       asp-route-committeeId="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Mission
                    </a>
                    <a asp-action="ManageObjective"
                       asp-route-committeeId="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Objectives
                    </a>
                    <a asp-action="ManageSubObjective"
                       asp-route-committeeId="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Sub-Objectives
                    </a>
                    <form asp-action="Delete"
                          asp-route-committeeid="@item.Id"
                          method="post"
                          style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this campus committee?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">
                            Delete
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
