@model GECPATAN_FACULTY_PORTAL.Models.CampusCommittee

<h2>Edit Campus Committee</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tagline</label>
        <input asp-for="Tagline" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">About</label>
        <textarea asp-for="About" class="form-control" rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Title Image</label>
        <input asp-for="TitleImage" class="form-control" />
    </div>

    <div class="form-check mb-2">
        <input asp-for="ShowDocument" class="form-check-input" />
        <label class="form-check-label">Show Document</label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="TableView" class="form-check-input" />
        <label class="form-check-label">Table View</label>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
