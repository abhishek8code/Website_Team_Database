@model IEnumerable<ProfessionalExperience>

<h3>Professional Experience</h3>

<a asp-action="CreateExperience"
   asp-route-id="@ViewBag.FacultyId"
   class="btn btn-primary mb-2">
    Add Experience
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Position</th>
            <th>Organization</th>
            <th>Duration</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Position</td>
                <td>@item.Organization</td>
                <td>@item.Duration</td>
                <td>
                    <a asp-action="EditExperience"
                       asp-route-id="@item.ProfessionalExperienceId">
                        Edit
                    </a> |
                    <a asp-action="DeleteExperience"
                       asp-route-id="@item.ProfessionalExperienceId"
                       onclick="return confirm('Delete this record?')">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">
    Back to Faculty List
</a>
