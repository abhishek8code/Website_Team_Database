@model ProfessionalExperience

<form asp-action="EditExperience" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ProfessionalExperienceId" />
    <input type="hidden" asp-for="FacultyId" />

    <div class="form-group">
        <label>Position</label>
        <input asp-for="Position" class="form-control" />
    </div>

    <div class="form-group">
        <label>Organization</label>
        <input asp-for="Organization" class="form-control" />
    </div>

    <div class="form-group">
        <label>Duration</label>
        <input asp-for="Duration" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Experience"
       asp-route-id="@Model.FacultyId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
