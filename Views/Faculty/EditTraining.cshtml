@model TrainingAndWorkshop

<form asp-action="EditTraining" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="TrainingAndWorkshopId" />
    <input type="hidden" asp-for="FacultyId" />

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label>Organized By</label>
        <input asp-for="OrganizedBy" class="form-control" />
    </div>

    <div class="form-group">
        <label>Date</label>
        <input asp-for="Date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Training"
       asp-route-id="@Model.FacultyId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
