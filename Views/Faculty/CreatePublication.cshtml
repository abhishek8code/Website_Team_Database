@model Publication

<form asp-action="CreatePublication" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="FacultyId" value="@ViewBag.FacultyId" />

    <div class="form-group">
        <label>Sr No</label>
        <input asp-for="SrNo" type="number" class="form-control" />
    </div>

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Publication"
       asp-route-id="@ViewBag.FacultyId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
