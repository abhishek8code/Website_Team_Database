@model GECPATAN_FACULTY_PORTAL.Models.DepartmentMission

<h4>Edit Mission</h4>
<hr />

<form asp-action="EditMission" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Dept_ID" />

    <div class="form-group">
        <label asp-for="MissionText"></label>
        <textarea asp-for="MissionText"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-success mt-2">
        Update Mission
    </button>

    <a asp-action="ManageMission"
       asp-route-committeeId="@Model.Dept_ID"
       class="btn btn-secondary mt-2 ms-2">
        Cancel
    </a>
</form>
