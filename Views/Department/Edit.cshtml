@model GECPATAN_FACULTY_PORTAL.Models.Departments
@{
    ViewData["Title"] = "Edit Department";
}
<h2>Edit Department</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Upload Image</label>
        <input type="file" name="Image" class="form-control" />
    </div>


    <div class="mb-3">
        <label class="form-label">Tagline</label>
        <input asp-for="Tagline" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">About</label>
        <textarea asp-for="About" class="form-control" rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Title Image</label>
        <input asp-for="TitleImage" class="form-control" />
    </div>
    @* <div class="form-check mb-3">
        <input asp-for="TableView" class="form-check-input" />
        <label class="form-check-label">Table View</label>
    </div> *@
    <div class="mb-3">
            <label class="form-label">Show Intake</label>
            <input asp-for="ShowIntake" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}